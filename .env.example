TELEMETRY_AGENTS_AZURE_OPENAI_HYPOTHESIS_DEPLOYMENT_NAME=hypothesis-model
TELEMETRY_AGENTS_AZURE_OPENAI_EVALUATION_DEPLOYMENT_NAME=evaluation-model
TELEMETRY_AGENTS_TRACING_ENABLED=true
TELEMETRY_AGENTS_DATA_ROOT=eval_data
TELEMETRY_AGENTS_EVAL_DATA_ROOT=eval_data