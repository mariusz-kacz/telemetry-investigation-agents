# Copy this file to .env for local configuration.
#
# Default mode for local deterministic execution. This uses deterministic local
# generator/critic adapters while still running retrieval, LangGraph workflow,
# validation, review policy, checkpointing, API, and UI paths.
# fake/azure
TELEMETRY_AGENTS_DEMO_PROVIDER=fake

# Required only when TELEMETRY_AGENTS_DEMO_PROVIDER=azure or when running live
# evaluations with `uv run telemetry-evals --provider azure`.
# Authentication uses Microsoft Entra ID through DefaultAzureCredential.
TELEMETRY_AGENTS_AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/openai/v1
TELEMETRY_AGENTS_AZURE_OPENAI_HYPOTHESIS_DEPLOYMENT_NAME=<hypothesis-deployment-name>
TELEMETRY_AGENTS_AZURE_OPENAI_EVALUATION_DEPLOYMENT_NAME=<evaluation-deployment-name>

# Local console tracing is optional. Structured JSON events are still emitted
# when tracing is disabled.
TELEMETRY_AGENTS_TRACING_ENABLED=false
TELEMETRY_AGENTS_TRACING_EXPORTER=otlp
TELEMETRY_AGENTS_OTLP_ENDPOINT=http://localhost:4317

# Synthetic demo/eval data roots. The demo UI discovers cases from
# TELEMETRY_AGENTS_DATA_ROOT/cases.
TELEMETRY_AGENTS_DATA_ROOT=eval_data
TELEMETRY_AGENTS_EVAL_DATA_ROOT=eval_data

# Local SQLite files for LangGraph checkpoints and the API/UI run registry.
TELEMETRY_AGENTS_CHECKPOINT_DB_PATH=.local/checkpoints.sqlite
TELEMETRY_AGENTS_RUN_REGISTRY_DB_PATH=.local/run-registry.sqlite
