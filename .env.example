# Copy this file to .env for local configuration.
# The default demo provider is deterministic and does not call Azure OpenAI.
TELEMETRY_AGENTS_DEMO_PROVIDER=fake

# Required only when TELEMETRY_AGENTS_DEMO_PROVIDER=azure or when running
# `uv run telemetry-evals --provider azure`.
TELEMETRY_AGENTS_AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/openai/v1
TELEMETRY_AGENTS_AZURE_OPENAI_HYPOTHESIS_DEPLOYMENT_NAME=<hypothesis-deployment-name>
TELEMETRY_AGENTS_AZURE_OPENAI_EVALUATION_DEPLOYMENT_NAME=<evaluation-deployment-name>
TELEMETRY_AGENTS_TRACING_ENABLED=true
TELEMETRY_AGENTS_DATA_ROOT=eval_data
TELEMETRY_AGENTS_EVAL_DATA_ROOT=eval_data
TELEMETRY_AGENTS_CHECKPOINT_DB_PATH=.local/checkpoints.sqlite
TELEMETRY_AGENTS_RUN_REGISTRY_DB_PATH=.local/run-registry.sqlite
