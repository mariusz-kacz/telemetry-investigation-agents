flowchart LR
    User["Person: demo user"]

    subgraph Browser["Browser"]
        UI["React/Vite demo UI"]
    end

    subgraph Backend["Python backend"]
        API["FastAPI API<br/>DTO boundary"]
        App["Demo investigation service<br/>run lifecycle and composition"]
        Retrieval["Deterministic evidence retrieval<br/>logs, traces, metrics"]
        Graph["LangGraph workflow<br/>hypotheses, review, report"]
        Providers["Hypothesis generator and critic adapters"]
    end

    Telemetry["Synthetic telemetry files"]
    Registry["SQLite run registry"]
    Checkpoints["SQLite LangGraph checkpoints"]

    subgraph External["Optional external service"]
        LLM["External LLM service"]
    end

    User -->|"uses"| UI
    UI -->|"HTTP /api/v1 DTOs"| API
    API -->|"delegates"| App
    App -->|"loads incident and telemetry"| Retrieval
    Retrieval -->|"reads"| Telemetry
    Retrieval -->|"ranked cited evidence"| App
    App -->|"invokes or resumes"| Graph
    Graph -->|"uses configured adapter"| Providers
    Providers -->|"provider-backed mode"| LLM
    App -->|"stores run metadata"| Registry
    Graph -->|"persists workflow state"| Checkpoints
